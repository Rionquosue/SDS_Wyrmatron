# Host paths; leave unset to use named volumes.
# BOT_DATA_DIR=/srv/wyrmatron/data
# BOT_WORK_DIR=/srv/wyrmatron/work
# Holds config.toml, whitelist.cfg and blocklist.cfg; must be writable by UID 10001.
BOT_CONFIG_DIR=./config
TELEGRAM_TOKEN_PATH=./secrets/telegram_token
FFMPEG_KEY_PATH=./secrets/ffmpeg_key
MEDIA_NETWORK=media_processing
BOT_SERVICES_NETWORK=bot_services
RUST_LOG=info
