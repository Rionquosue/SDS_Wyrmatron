# The user and group the bot runs as. Use your own IDs (`id -u`, `id -g`) so
# everything it writes in ./config, ./data and ./work belongs to you, with no
# sudo. Rootless Docker: 0 and 0 (container root is your user). Rootless
# Podman: your own IDs together with `userns_mode: keep-id` (see README).
BOT_UID=1000
BOT_GID=1000

# Host directories for the database and the media spool. Create them first
# (`mkdir -p data work`): Docker would create missing ones owned by root.
# Comment these out to use Docker named volumes instead.
BOT_DATA_DIR=./data
BOT_WORK_DIR=./work
# Holds config.toml, whitelist.cfg and blocklist.cfg; must be writable by BOT_UID.
BOT_CONFIG_DIR=./config
TELEGRAM_TOKEN_PATH=./secrets/telegram_token
FFMPEG_KEY_PATH=./secrets/ffmpeg_key
MEDIA_NETWORK=media_processing
BOT_SERVICES_NETWORK=bot_services
RUST_LOG=info
